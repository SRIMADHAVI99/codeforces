#include <iostream>
#include <vector>
#include <algorithm>
#include <climits>

using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        long long sumSecond = 0;
        long long globalMin = LLONG_MAX;
        long long smallestSecond = LLONG_MAX;

        for (int i = 0; i < n; i++) {
            int m;
            cin >> m;

            vector<long long> a(m);

            for (int j = 0; j < m; j++) {
                cin >> a[j];
            }

            sort(a.begin(), a.end());

            globalMin = min(globalMin, a[0]);

            sumSecond += a[1];

            smallestSecond = min(smallestSecond, a[1]);
        }

        if (n == 1) {
            cout << globalMin << endl;
        }
        else {
            cout << sumSecond - smallestSecond + globalMin << endl;
        }
    }

    return 0;
}
